* text=auto

*.cmd text eol=crlf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve vendor legal texts byte-for-byte so their audited hashes remain
# stable across Windows and Unix checkouts.
Legal/*.txt binary

*.ico binary
*.png binary
*.zip binary
*.msix binary
