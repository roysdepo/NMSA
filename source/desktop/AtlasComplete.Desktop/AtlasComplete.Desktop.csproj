<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AssemblyName>NMSA</AssemblyName>
    <RootNamespace>Nmsa.Desktop</RootNamespace>
    <Version>3.0.6</Version>
    <Product>NMSA - No Man's Sky Atlas</Product>
    <Title>NMSA - No Man's Sky Atlas</Title>
    <ApplicationIcon>Assets\nmsa.ico</ApplicationIcon>
    <Description>Local-first No Man's Sky save completion, repair, backup, and recovery.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\dist\desktop\NMSA.html"
             Link="Web\NMSA.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\dist\desktop\nmsa.css"
             Link="Web\nmsa.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\dist\desktop\nmsa.js"
             Link="Web\nmsa.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
