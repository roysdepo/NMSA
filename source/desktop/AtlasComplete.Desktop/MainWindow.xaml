<Window x:Class="Nmsa.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="NMSA - No Man's Sky Atlas"
        Width="1440"
        Height="920"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="NMSA No Man's Sky Atlas save editor">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="NMSA" />
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="No Man's Sky Atlas" />
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="7,3"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Text="v3.0.6 · .NET 10" />
                </Border>

                <ProgressBar Grid.Column="2"
                             Width="180"
                             Height="3"
                             Margin="24,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.Name="NMSA startup progress" />

                <Button Grid.Column="3"
                        MinWidth="88"
                        Click="RefreshButton_Click"
                        IsEnabled="{Binding CanRefresh}"
                        AutomationProperties.Name="Refresh NMSA editor">
                    <TextBlock Text="_Refresh" />
                </Button>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Browser"
                      Grid.Row="1"
                      DefaultBackgroundColor="#071019"
                      Visibility="{Binding IsBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.Name="NMSA editor" />

        <Grid Grid.Row="1"
              Margin="32"
              Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="680"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               Text="NMSA could not start" />
                    <TextBlock Margin="0,12,0,20"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left"
                            Click="RetryButton_Click"
                            AutomationProperties.Name="Retry starting NMSA">
                        <TextBlock Text="_Retry" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0"
                         Width="7"
                         Height="7"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource AccentBrush}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding StatusText}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Windows desktop" />
            </Grid>
        </Border>
    </Grid>
</Window>
